# DFS Ops — environment variable template
# Copy to .env for local dev. NEVER commit a real .env (it is gitignored).
# In production, set these in the Vercel dashboard (Settings → Environment Variables),
# NOT in a committed file.

# --- Supabase ---------------------------------------------------------------
# The project URL and anon key are public (RLS-protected) and have safe
# fallbacks baked into server/supabase.ts, so these are optional. Set them only
# to override. If set, SUPABASE_URL must point at a real *.supabase.co host.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRET. Required to enable self-service account creation and privileged writes.
# Flips adminReady=true. Store as an ENCRYPTED env var in Vercel — never commit.
# Where to find it: Supabase dashboard → Project Settings → API →
# "service_role" secret (NOT the anon/publishable key). It is never exposed via
# any API/connector — you must copy it from the dashboard yourself.
# After setting it in Vercel, redeploy; GET /api/health should show adminReady:true.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------------
# SECRET. Required to send notification emails. Without it, email is disabled.
RESEND_API_KEY=
# Verified sender. Defaults to Resend's sandbox sender (only delivers to your
# own verified address) if unset.
EMAIL_FROM=

# --- Runtime ----------------------------------------------------------------
# Vercel sets this automatically in production. Only needed for local runs.
# NODE_ENV=development
# PORT=5000
